    {
        "id": "7d50341a644f40c2",
        "type": "function",
        "z": "sa_tab",
        "g": "46e19fa9e1cfab74",
        "name": "Craft Response",
        "func": "// Check if the response contains the expected Gemini data structure\nif (msg.payload && msg.payload.candidates && msg.payload.candidates[0].content) {\n\n    // Map the deep JSON text property directly to msg.payload\n    msg.payload = msg.payload.candidates[0].content.parts[0].text;\n\n} else {\n    // Fallback message in case the API returned something unexpected\n    msg.payload = \"Error: Could not parse response from Gemini.\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 700,
        "wires": [
            [
                "e08bc413ab2948b2"
            ]
        ]
    },
    {
        "id": "a9c0545579f99e4e",
        "type": "function",
        "z": "sa_tab",
        "g": "46e19fa9e1cfab74",
        "name": "Craft Request",
        "func": "msg.url = flow.get(\"gemini_model_url\");\nmsg.url += \"?key=\" + flow.get(\"gemini_api_key\");\n\n// Context\nlet userQuestion = msg.payload;\n\nif (!userQuestion || userQuestion.toString().trim() === \"\") {\n    return null;\n}\n\nmsg.payload = {\n    contents: [\n        {\n            parts: [\n                { \n                    text: `Context: ${flow.get(\"gemini_prompt\")}\n                        Air Temperature = ${flow.get('dht_temp') }\n                        Air Humidity = ${flow.get('dht_hum') }\n\n                        Soil Moisture = ${flow.get('soil_moisture') }\n                        \n                        User Question: ${userQuestion}`\n                }\n            ]\n        }\n    ]\n};\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 220,
        "y": 700,
        "wires": [
