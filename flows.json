    {
        "id": "001c4777751f7f97",
        "type": "function",
        "z": "sa_tab",
        "g": "398014290f26b1a5",
        "name": "Craft Email",
        "func": "const temp = flow.get(\"dht_temp\");\nconst hum = flow.get(\"dht_hum\");\nconst email = flow.get(\"email\");\n\nif (!email || email.toString().trim() === \"\" || (!temp && !hum)) return null;\nelse msg.to = email;\n\nif (temp < 40 && hum < 80) return null;\n\nif (temp > 40 && hum > 80) {\n    msg.topic = \"⚠️ Cảnh báo nhiệt độ & độ ẩm\";\n    msg.payload = \"Nhiệt độ cao: \" + temp + \"°C\\nĐộ ẩm cao: \" + hum + \"%\";\n}\n\nif (temp > 40) {\n    msg.topic = \"⚠️ Cảnh báo nhiệt độ\";\n    msg.payload = \"Nhiệt độ cao: \" + temp + \"°C\";\n}\n\nif (hum > 80) {\n    msg.topic = \"💧 Cảnh báo độ ẩm\";\n    msg.payload = \"Độ ẩm cao: \" + hum + \"%\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 460,
        "wires": [
