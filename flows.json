    {
        "id": "f42f904625e7e16a",
        "type": "function",
        "z": "sa_tab",
        "name": "Telegram Message",
        "func": "const temp = msg.payload.temp;\nconst hum = msg.payload.hum;\n\nconst chatid = Number(flow.get(\"chatid\"));\n\nif (!chatid) return null;\n\nif (temp > 40 && hum > 80) {\n    msg.payload = {\n        chatId: chatid,\n        type: \"message\",\n        content: \"⚠️ Nhiệt độ cao: \" + temp + \"°C\\n💧 Độ ẩm cao: \" + hum + \"%\"\n    }\n    return msg;\n}\n\nif (temp > 40) {\n    msg.payload = {\n        chatId: chatid,\n        type: \"message\",\n        content: \"⚠️ Nhiệt độ cao: \" + temp + \"°C\"\n    }\n    return msg;\n}\n\nif (hum > 80) {\n    msg.payload = {\n        chatId: chatid,\n        type: \"message\",\n        content: \"💧 Độ ẩm cao: \" + hum + \"%\"\n    }\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 440,
        "wires": [
            [
                "881e3362f6373ed9"
            ]
        ]
