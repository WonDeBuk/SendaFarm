    {
        "id": "ca97214bf8c94dbf",
        "type": "function",
        "z": "sa_tab",
        "g": "c70a3beadd96d549",
        "name": "1 Hour Query",
        "func": "// 1. Tính mốc thời gian cách đây 1 tiếng (chuẩn ISO)\nlet oneHourAgo = new Date(Date.now() - 3600000).toISOString();\n\n// 2. Tạo URL lấy dữ liệu bảng Data\n// Lưu ý: Dùng order=created_at.asc để dữ liệu sắp xếp từ cũ tới mới, \n// giúp biểu đồ vẽ đúng chiều từ trái qua phải.\nmsg.url = \"https://cuvnngyogjbudkvivnlo.supabase.co/rest/v1/Data?select=*&created_at=gte.\" + oneHourAgo + \"&order=created_at.asc\";\n\n// 3. Cấu hình Headers (Thay API Key của bạn vào)\nmsg.headers = {\n    \"apikey\": \"sb_secret_twz3ZtLu_2lJffNqC_Cvcw_yKACowqr\",\n    \"Authorization\": \"Bearer sb_secret_twz3ZtLu_2lJffNqC_Cvcw_yKACowqr\"\n};\n\n// 4. Xóa payload rác sinh ra từ node ui control để tránh gây lỗi HTTP Request\nmsg.payload = {};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
