    {
        "id": "001c4777751f7f97",
        "type": "function",
        "z": "sa_tab",
        "name": "Email Message",
        "func": "const temp = msg.payload.temp;\nconst hum = msg.payload.hum;\n\nconst email = flow.get(\"email\");\n\nif (!email) return null;\n\nif (temp > 40 && hum > 80) {\n    msg.to = email;\n    msg.topic = \"⚠️ Cảnh báo nhiệt độ & độ ẩm\";\n    msg.payload = \"Nhiệt độ cao: \" + temp + \"°C\\nĐộ ẩm cao: \" + hum + \"%\";\n    return msg;\n}\n\nif (temp > 40) {\n    msg.to = email;\n    msg.topic = \"⚠️ Cảnh báo nhiệt độ\";\n    msg.payload = \"Nhiệt độ cao: \" + temp + \"°C\";\n    return msg;\n}\n\nif (hum > 80) {\n    msg.to = email;\n    msg.topic = \"💧 Cảnh báo độ ẩm\";\n    msg.payload = \"Độ ẩm cao: \" + hum + \"%\";\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
