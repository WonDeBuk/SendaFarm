        "func": "msg.url = \"https://cuvnngyogjbudkvivnlo.supabase.co/rest/v1/Data\"\nmsg.payload = {\n    temp: flow.get(\"dht_temp\"),\n    hum: flow.get(\"dht_hum\"),\n    sm: flow.get(\"soil_moisture\")\n};\n\n\n// Cấu hình các Headers bắt buộc của Supabase\nmsg.headers = {\n    \"apikey\": \"sb_secret_twz3ZtLu_2lJffNqC_Cvcw_yKACowqr\",\n    \"Authorization\": \"Bearer sb_secret_twz3ZtLu_2lJffNqC_Cvcw_yKACowqr\",\n    \"Content-Type\": \"application/json\",\n    \"Prefer\": \"return=representation\" // Yêu cầu trả về data sau khi insert thành công (tùy chọn)\n};\n\nreturn msg;",
